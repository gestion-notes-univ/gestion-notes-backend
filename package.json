{
  "name": "gestion-notes-backend",
  "version": "1.0.0",
  "description": "Backend pour la gestion des notes universitaires avec API Platform et Symfony 7.4",
  "main": "public/index.php",
  "scripts": {
    "start": "symfony server:start",
    "dev": "symfony server:start --no-tls",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "migrate": "php bin/console doctrine:migrations:migrate",
    "fixtures": "php bin/console doctrine:fixtures:load --no-interaction",
    "seed": "php bin/console app:seed-demo-data"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gestion-notes-univ/gestion-notes-backend.git"
  },
  "keywords": [
    "symfony",
    "api-platform",
    "backend",
    "notes"
  ],
  "author": "Gestion Notes Université",
  "license": "proprietary",
  "bugs": {
    "url": "https://github.com/gestion-notes-univ/gestion-notes-backend/issues"
  },
  "homepage": "https://github.com/gestion-notes-univ/gestion-notes-backend#readme"
}
